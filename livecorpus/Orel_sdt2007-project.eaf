    <TIER ANNOTATOR="@sdt2007f" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@sdt2007f" TIER_ID="comment">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>по идее вот это частица, но я ее использую просто чтобы заполнить паузу so междометие</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>вместе как будто это частица, но это разные токены поэтому так</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>то есть это вводное слово, но надо как-то разметить отдельно...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts143">
                <ANNOTATION_VALUE>в первом случае там заполняет паузу, в двух др случаях используется в значении например</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a836"
                TIME_SLOT_REF1="ts226" TIME_SLOT_REF2="ts237">
                <ANNOTATION_VALUE>а здесь я тут употребляю со значением места</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1717"
                TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>в аналогичных примерах нкря было нар</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1823"
                TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE>в нкря вообще написано что типа - предлог..., но это явно не он</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1685"
                TIME_SLOT_REF1="ts466" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>в данном случае не союз, я не предполагала тут противопоставлеия</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1813"
                TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>пыталась сколько смотреть в нкря но примеры не репрезентативные</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1941"
                TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts941">
                <ANNOTATION_VALUE>субстантивированное прил</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a961"
                TIME_SLOT_REF1="ts1086" TIME_SLOT_REF2="ts1093">
                <ANNOTATION_VALUE>простите я не смеюсь над лудоманами, это грустно, всем желаю ментального здоровья</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
