        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>по идее вот это частица, но я ее использую просто чтобы заполнить паузу so междометие</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>вместе как будто это частица, но это разные токены поэтому так</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764"
                TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>то есть это вводное слово, но надо как-то разметить отдельно...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>в первом случае там заполняет паузу, в двух др случаях используется в значении например</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a836"
                TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>а здесь я тут употребляю со значением места</ANNOTATION_VALUE>
